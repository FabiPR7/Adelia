# IMPORTANTE
# Todo lo que empieza por VITE_ se incluye en el JavaScript del navegador.
# NUNCA pongas secretos con el prefijo VITE_ (STRIPE_SECRET_KEY, RESEND_API_KEY,
# INTERNAL_API_SECRET, service accounts, webhooks).
# Las claves VITE_FIREBASE_* y VITE_STRIPE_PUBLISHABLE_KEY son públicas a propósito.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_DATABASE_ID=adelia
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
# Nota: VITE_CLOUDINARY_CLOUD_NAME también debe estar en el entorno de las
# Cloud Functions. Si está, el backend solo acepta URLs de medios cuya ruta
# empiece por ese cloud (evita incrustar archivos de otra cuenta Cloudinary).

# reCAPTCHA v3 (opcional). Sin estas claves el registro funciona igual.
# VITE_RECAPTCHA_SITE_KEY=
# RECAPTCHA_SECRET_KEY=
# Fuerza el fallo cerrado: si no hay RECAPTCHA_SECRET_KEY, el registro se
# rechaza en vez de dejar pasar sin verificar. Recomendado en producción.
# RECAPTCHA_REQUIRED=true

# Mapas (opcional). Sin key usa OpenStreetMap en desarrollo.
# VITE_MAPTILER_API_KEY=
# VITE_GOOGLE_MAPS_API_KEY=

# API local (opcional). Vacío = misma origen /api
# VITE_API_URL=

# Email (Resend) — solo servidor
RESEND_API_KEY=
EMAIL_FROM=Adelia Reservas <no-reply@adeliareservas.com>
EMAIL_REPLY_TO=contacto@adeliareservas.com
APP_URL=https://adeliareservas.com

# CORS extra (coma). Por defecto: adeliareservas.com + hosting Adelia + localhost en dev.
# CORS_ORIGINS=https://otro-dominio-tuyo.com

# Secreto interno opcional para jobs servidor-a-servidor. No lo uses en el cliente.
# INTERNAL_API_SECRET=

# Solo dev local sin serviceAccountKey.json: habilita la verificación de admin
# por REST. En producción (Cloud) no hace falta y debe quedar sin definir.
# ALLOW_REST_ADMIN_FALLBACK=true

# Cloud Functions producción: instancias siempre calientes de la API para evitar
# cold starts en la ruta de reserva. Cuesta dinero. Recomendado: 1.
# API_MIN_INSTANCES=1

# Tope de XP que un cliente puede ganar al día vía /api/customer/gamification/sync
# (el navegador propone la XP de misiones). Sube esto solo si el catálogo de
# misiones diarias crece mucho. Por defecto 5000.
# SYNC_XP_DAILY_CEILING=5000

# Techo absoluto de XP por cliente, calculado con datos de confianza del servidor
# (reservas, consumos, antigüedad de la cuenta): nadie puede superar la XP de un
# jugador perfecto. Ponlo a "false" solo si sospechas que recorta a usuarios
# reales (no debería). Por defecto activo.
# GAMIFICATION_XP_CEILING_ENABLED=false

# Stripe — SOLO Connect: cuenta conectada del restaurante y fianzas de
# reserva (el cliente paga la fianza a la cuenta Connect del restaurante).
# El plan mensual/anual (Sala/Local) NO pasa por Stripe, va por Lemon Squeezy
# (sección de abajo); el webhook de Stripe ignora cualquier evento de
# checkout/invoice/subscription que no sea `account.updated`.
# En desarrollo usa siempre sk_test_/pk_test_. En producción
# (functions/.env.adelia-ccdaf) puede ir en modo live (sk_live_/pk_live_) si
# ya se han validado fianzas reales con restaurantes; si es live, el
# STRIPE_WEBHOOK_SECRET tiene que ser el del endpoint en modo Live del
# Dashboard (no el de Test), y VITE_STRIPE_PUBLISHABLE_KEY de la build de
# producción va en .env.production (no en este .env de desarrollo), a juego
# con la misma clave/modo.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Cuenta Connect de prueba para vincular con `node scripts/link-company-stripe.mjs carol`
# (solo dev local, con claves sk_test_/pk_test_).
TEST_RESTAURANTE_STRIPE_ID=acct_...

# Lemon Squeezy — pago mensual de los planes Sala / Local (sustituye al checkout
# de Stripe). El "signing secret" lo defines tú al crear el webhook en LS
# (Settings -> Webhooks) apuntando a POST /api/lemonsqueezy/webhook.
LEMONSQUEEZY_WEBHOOK_SECRET=

# Cloud Functions (producción): copia RESEND + STRIPE + LEMONSQUEEZY de arriba a
# functions/.env.adelia-ccdaf y usa APP_URL=https://adeliareservas.com (no localhost)
