    "@types/express": "^5.0.6",
    "@types/leaflet": "^1.9.22",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "concurrently": "^10.0.4",
    "happy-dom": "^20.11.2",
    "jsdom": "^29.1.1",
    "sharp": "^0.35.3",
    "tsx": "^4.23.1",
