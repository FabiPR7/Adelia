rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userDocExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return isSignedIn() && userDocExists() && userDoc().data.role == 'admin';
    }

    function hasNoPasswordSecrets(data) {
      return !('loginPassword' in data)
        && !('password' in data)
        && !('passwordHash' in data)
        && !('passwordSalt' in data);
    }

    function isCompanyOwner(companyId) {
      return isSignedIn() && (
        (
          exists(/databases/$(database)/documents/companies/$(companyId))
          && get(/databases/$(database)/documents/companies/$(companyId)).data.ownerUid == request.auth.uid
        )
        || (
          userDocExists()
          && userDoc().data.role == 'company'
          && userDoc().data.companyId == companyId
        )
      );
    }

    match /logins/{loginId} {
      // Empresas pueden leer su propio login, admins todo
      allow get: if isAdmin() || (
        isSignedIn()
        && resource.data.companyId is string
        && isCompanyOwner(resource.data.companyId)
      );
      allow list: if false;
      allow create: if false;
      // Update: el dueño del doc existente (no solo el companyId nuevo).
      allow update: if false;
      allow delete: if false;
    }

    match /companyCredentials/{companyId} {
      allow read: if isAdmin() || isCompanyOwner(companyId);
      allow create: if false;
      allow delete: if false;
      allow update: if false;
    }

    match /passwordResetTokens/{tokenId} {
      allow read, write: if false;
    }

    match /rateLimits/{limitId} {
      // Solo Cloud Functions pueden leer/escribir
      allow read, write: if false;
    }

    match /stripeEvents/{eventId} {
      // Registro de idempotencia de webhooks de Stripe. Solo backend (Admin SDK).
      allow read, write: if false;
    }

    match /lemonSqueezyEvents/{eventId} {
      // Idempotencia de webhooks de Lemon Squeezy. Solo backend (Admin SDK).
      allow read, write: if false;
    }

    match /usernames/{username} {
      // Reserva de @usuarios únicos: solo la API (Admin SDK).
      allow read, write: if false;
    }

    match /restaurantReports/{reportId} {
      // Reportes de clientes sobre restaurantes. Se crean y leen solo por la API.
      allow read, write: if false;
    }

    match /billingLedger/{entryId} {
      // Libro de cobros (facturas y pagos únicos). Solo backend; el admin lo lee por la API.
      allow read, write: if false;
    }

    match /lemonSqueezyPending/{emailKey} {
      // Plan pagado en Lemon Squeezy antes de existir la empresa. Solo backend.
      allow read, write: if false;
    }

    match /appEvents/{eventId} {
      // Eventos crudos de analítica de la app. Solo backend (Admin SDK).
      allow read, write: if false;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isSafePhotoUrl(url) {
      return url is string
        && url.size() <= 500
        && (
          url == ''
          // matches() tiene que cubrir el texto entero: sin «.*» final ninguna
          // foto real encajaba y el cliente con foto no podía guardar su perfil.
          || url.matches('^https://res\\.cloudinary\\.com/.*')
          || url.matches('^https://[a-z0-9.-]*googleusercontent\\.com/.*')
        );
    }

    function isFreshCustomerEconomy(data) {
      return data.xp == 0
        && data.adelinas == 0
        && data.gamification.xp == 0
        && data.gamification.adelinas == 0
        && data.gamification.completedMissions.size() == 0
        && data.gamification.inventory.size() == 0
        && data.gamification.claimedPromotions.size() == 0
        && data.gamification.pendingTokenSpend.size() == 0
        && data.gamification.grantedItemKeys.size() == 0
        && data.gamification.visitedCompanyIds.size() == 0
        && data.gamification.promoLocked == false
        && data.gamification.cancellationStrikeCount == 0;
    }

    function isValidCustomerCreate() {
      let data = request.resource.data;
      return data.role == 'customer'
        && data.companyId == null
        && data.email is string
        && data.email.size() > 0
        && data.email.size() <= 120
        // El correo del perfil tiene que ser el de la cuenta: si no, uno podría
        // apuntarse con el correo de otra persona.
        && request.auth.token.email is string
        && data.email == request.auth.token.email.lower()
        && data.displayName is string
        && data.displayName.size() > 0
        && data.displayName.size() <= 80
        && (data.authProvider == 'password' || data.authProvider == 'google.com')
        && data.mustChangePassword == false
        && data.onboardingCompleted == false
        && data.phone is string
        && data.phone.size() <= 30
        && data.phoneVerified == false
        && isSafePhotoUrl(data.photoUrl)
        && data.favoriteSlugs is list
        && data.favoriteSlugs.size() <= 200
        && data.foodPreferences is list
        && data.foodPreferences.size() <= 40
        && data.gamification is map
        && data.xp is int
        && data.adelinas is int
        && isFreshCustomerEconomy(data)
        && (!('blocked' in data) || data.blocked == false)
        && (data.homeLatitude == null || data.homeLatitude is number)
        && (data.homeLongitude == null || data.homeLongitude is number)
        && data.createdAt == request.time
        // El @usuario solo lo pone el servidor (comprueba que no esté cogido).
        && !('username' in data)
        && hasNoPasswordSecrets(data);
    }

    function customerProfileUpdateKeys() {
      return [
        'displayName',
        'displayNameLower',
        'favoriteSlugs',
        'phone',
        'photoUrl',
        'homeCity',
        'homeMunicipality',
        'homeCountry',
        'homePostalCode',
        'homeLatitude',
        'homeLongitude',
        'foodPreferences',
        'onboardingCompleted',
        'productTourCompleted',
      ];
    }

    match /users/{userId} {
      allow create: if false;
      allow read: if isSelf(userId) || isAdmin();
      allow update: if false;
      allow delete: if false;

      match /notifications/{notificationId} {
        allow read: if isSelf(userId) || isAdmin();
        allow update: if false;
        allow create, delete: if false;
      }

      match /friendRequests/{requestId} {
        allow read: if isSelf(userId) || isAdmin();
        allow write: if false;
      }

      match /outgoingFriendRequests/{requestId} {
        allow read: if isSelf(userId) || isAdmin();
        allow write: if false;
      }

      match /friends/{friendId} {
        allow read: if isSelf(userId) || isAdmin();
        allow write: if false;
      }
    }

    match /notificationJobs/{jobId} {
      allow read, write: if false;
    }

    function companyOwnerUpdatableKeys() {
      return [
        'name',
        'contactEmail',
        'phone',
        'website',
        'location',
        'municipality',
        'country',
        'postalCode',
        'latitude',
        'longitude',
        'description',
        'logoUrl',
        'photos',
        'mainPhotoIndex',
        'videos',
        'characteristics',
        'venueTypes',
        'amenities',
        'priceRange',
        'timeSlotMinutes',
        'reservationMode',
        'depositMinPax',
        'depositPerGuestCents',
        'depositEnabled',
        'depositCancellationHours',
        'schedule',
        'turns',
        'floorPlan',
        'floorPlans',
        'qrBranding',
        'deactivated',
        'deactivatedAt',
        'updatedAt',
      ];
    }

    // Tipos de promoción por plan (server/company/planLimits.ts). Las reglas no
    // pueden contar documentos: el tope por cantidad lo aplica la API pública.
    function companyPlanAllowsPromotion(companyId, promotion) {
      let planId = get(/databases/$(database)/documents/companies/$(companyId)).data.get('planId', 'free');
      return planId == 'premium'
        || planId == 'premium_plus'
        || (planId == 'basic' && promotion.get('type', '') == 'reservation_ladder');
    }

    function isValidCompanyOwnerUpdate() {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return changedKeys.hasOnly(companyOwnerUpdatableKeys())
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        // Duración de reserva razonable: con 0 el cálculo de horas no avanza.
        && (!changedKeys.hasAny(['timeSlotMinutes'])
          || (request.resource.data.timeSlotMinutes is int
            && request.resource.data.timeSlotMinutes >= 15
            && request.resource.data.timeSlotMinutes <= 240))
        // Si lo desactivó el administrador, el dueño no puede volver a activarlo.
        && !(resource.data.get('deactivatedByAdmin', false) == true
          && request.resource.data.get('deactivated', false) != true);
    }

    function reviewHasOwnerReply(data) {
      return data.keys().hasAny(['ownerReply'])
        && data.ownerReply is map
        && data.ownerReply.text is string
        && data.ownerReply.text.size() > 0;
    }

    function isValidCompanyReviewReplyUpdate(companyId) {
      let data = request.resource.data;
      let prev = resource.data;
      let changedKeys = data.diff(prev).affectedKeys();
      let reply = data.ownerReply;
      let hadReply = reviewHasOwnerReply(prev);

      return isCompanyOwner(companyId)
        && data.companyId == prev.companyId
        && changedKeys.hasOnly(['ownerReply'])
        && reply is map
        && reply.text is string
        && reply.text.size() >= 3
        && reply.text.size() <= 1000
        && reply.createdAt is timestamp
        && reply.updatedAt is timestamp
        && (
          (!hadReply && reply.createdAt == request.time && reply.updatedAt == request.time)
          || (
            hadReply
            && reply.createdAt == prev.ownerReply.createdAt
            && reply.updatedAt == request.time
          )
        );
    }

    match /companies/{companyId} {
      allow read: if isAdmin() || isCompanyOwner(companyId);
      allow create, delete: if false;
      allow update: if false;

      match /private/ops {
        // Stripe Connect: solo Admin SDK puede tocar stripe*.
        // El panel solo puede crear/actualizar plantillas de email.
        allow read: if isCompanyOwner(companyId) || isAdmin();
        allow create: if false;
        allow update: if false;
        allow delete: if false;
      }

      match /private/promotionPin {
        allow read: if isCompanyOwner(companyId) || isAdmin();
        allow create, update, delete: if false;
      }

      match /private/{privateDoc} {
        allow read: if isCompanyOwner(companyId) || isAdmin();
        allow write: if false;
      }

      match /metrics/{monthId} {
        // Contadores de analítica de la app (agregados por mes). Solo backend
        // escribe; el dueño y el admin leen para el informe "App".
        allow read: if isCompanyOwner(companyId) || isAdmin();
        allow write: if false;
      }

      match /clients/{clientId} {
        allow read: if isCompanyOwner(companyId) || isAdmin();
        allow create, update: if false;
        allow delete: if false;
      }

      match /promotions/{promotionId} {
        allow get: if resource.data.active == true || isCompanyOwner(companyId) || isAdmin();
        // list público desactivado: scrapeo collection-group. Público vía /api/public/promotions.
        allow list: if isCompanyOwner(companyId) || isAdmin();
        allow create: if false;
        // Desactivar siempre se puede; activar o editar una activa exige que el plan la incluya.
        allow update: if false;
        allow delete: if false;
      }

      match /menuBoards/{boardId} {
        allow get: if resource.data.active == true || isCompanyOwner(companyId) || isAdmin();
        // list público desactivado: scrapeo collection-group. Público vía /api/public/menus.
        allow list: if isCompanyOwner(companyId) || isAdmin();
        allow create, update, delete: if false;
      }

      match /menuNodes/{nodeId} {
        allow get: if resource.data.active == true || isCompanyOwner(companyId) || isAdmin();
        allow list: if isCompanyOwner(companyId) || isAdmin();
        allow create, update, delete: if false;
      }

      match /verifiedConsumptions/{consumptionId} {
        allow read: if isCompanyOwner(companyId) || isAdmin();
        allow write: if false;
      }

      match /reviews/{reviewId} {
        // El doc lleva customerUid y reservationId: no debe ser mundo-legible.
        // El público lee las reseñas por la API (/api/public/booking/:slug/reviews),
        // que las sanea con mapPublicReview.
        // El autor puede leer la suya (la app comprueba si ya opinó).
        // La reseña de un cliente se guarda con su uid como id: si no existe aún, puede comprobarlo.
        allow get: if isCompanyOwner(companyId) || isAdmin()
          || (isSignedIn() && (
            (resource == null && reviewId == request.auth.uid)
            || resource.data.customerUid == request.auth.uid
          ));
        allow list: if isCompanyOwner(companyId) || isAdmin()
          || (isSignedIn() && resource.data.customerUid == request.auth.uid);
        allow create: if false;
        allow update: if false;
        // Solo admin puede borrar reviews para mantener credibilidad del sistema
        // Las empresas pueden responder pero no eliminar reseñas negativas
        allow delete: if false;
      }

      match /notifications/{notificationId} {
        allow read: if isCompanyOwner(companyId) || isAdmin();
        allow update: if false;
        allow create, delete: if false;
      }
    }

    match /{path=**}/verifiedConsumptions/{consumptionId} {
      allow read: if isSignedIn()
        && resource.data.customerUid == request.auth.uid;
      allow write: if false;
    }

    match /tables/{tableId} {
      allow read: if isAdmin() || (
        isSignedIn() && isCompanyOwner(resource.data.companyId)
      );
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    function canReadReservation() {
      return isAdmin()
        || isCompanyOwner(resource.data.companyId)
        || (
          isSignedIn()
          && 'customerUid' in resource.data
          && resource.data.customerUid == request.auth.uid
        )
        || (
          isSignedIn()
          && request.auth.token.email_verified == true
          && resource.data.clientEmail is string
          && resource.data.clientEmail == request.auth.token.email
          && (
            !('customerUid' in resource.data)
            || resource.data.customerUid == null
            || resource.data.customerUid == ''
          )
        );
    }

    function reservationCompanyUpdatableKeys() {
      return [
        'tableId',
        'clientName',
        'clientEmail',
        'clientPhone',
        'pax',
        'startTime',
        'endTime',
        'status',
        'notes',
        'cancelledBy',
        'noShow',
        'cancelShieldRequested',
        'promotionVisitStatus',
        'clientSyncedAt',
        'updatedAt',
      ];
    }

    match /reservations/{reservationId} {
      allow get, list: if canReadReservation();
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    match /restaurantIndex/{companyId} {
      // get por id (favoritos, fichas). list solo vía Admin SDK (/api/public/discovery).
      allow get: if true;
      allow list: if false;
      // Lo escribe SOLO el servidor (disparador al cambiar el local). Antes lo
      // escribía el panel del restaurante y podía tocar campos como el plan o el mapa.
      allow create, update, delete: if false;
    }

    match /friendships/{friendshipId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.userIds;
      allow write: if false;
    }

    match /friendRequests/{requestId} {
      allow read: if isSignedIn()
        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow write: if false;
    }

    match /friendFavorites/{favoriteId} {
      allow read: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
      allow write: if false;
    }

    match /reservationInvites/{inviteId} {
      allow read: if isSignedIn()
        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow write: if false;
    }

    match /reservationChallenges/{challengeId} {
      allow read: if isSignedIn()
        && (
          resource.data.challengerUid == request.auth.uid
          || resource.data.challengedUid == request.auth.uid
        );
      allow write: if false;

      match /secret/{docId} {
        allow read, write: if false;
      }
    }

    match /companyGamification/{companyId} {
      allow read: if isCompanyOwner(companyId) || isAdmin();
      allow write: if false;
    }

    match /promotionClaims/{claimId} {
      allow read: if isSignedIn() && (
        resource.data.customerUid == request.auth.uid
        || isCompanyOwner(resource.data.companyId)
        || isAdmin()
      );
      allow write: if false;
    }

    match /userFavorites/{favoriteId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    match /reviewIndex/{reviewId} {
      // Lleva customerUid + reservationId + extracto del comentario. Solo admin.
      allow read: if isAdmin();
      allow write: if false;
    }

    match /saasSubscriptions/{sessionId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /saasReceipts/{receiptId} {
      allow read, write: if false;
    }

    match /{path=**}/stats/{statsId} {
      allow read, write: if false;
    }

    match /productClaims/{claimId} {
      allow read: if isSignedIn() && (
        resource.data.customerUid == request.auth.uid
        || isCompanyOwner(resource.data.companyId)
        || isAdmin()
      );
      allow write: if false;
    }

    match /missionCatalog/{missionId} {
      allow read: if true;
      allow write: if false;
    }

    match /levelCatalog/{levelId} {
      allow read: if true;
      allow write: if false;
    }

    match /gameConfig/{configId} {
      allow read: if true;
      allow write: if false;
    }

    // Catálogos editables (ítems, planes, facturación): lectura pública porque
    // la web los pinta sin sesión; escritura solo para administración.
    match /inventoryItems/{itemId} {
      allow read: if true;
      allow write: if false;
    }

    match /planCatalog/{planId} {
      allow read: if true;
      allow write: if false;
    }

    match /companyLevelCatalog/{levelId} {
      allow read: if true;
      allow write: if false;
    }

    match /companyMissionCatalog/{missionId} {
      allow read: if true;
      allow write: if false;
    }

    // Registro de cada cambio (lo escriben solo los disparadores del servidor).
    match /auditLog/{entryId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /appConfig/{configId} {
      // Solo lo que la web necesita es público; la configuración de seguridad y
      // de reglas de negocio solo la ve el admin (el servidor la lee con su cuenta).
      allow read: if configId in ['billing', 'planCapabilities'] || isAdmin();
      allow write: if false;
    }

    // Resúmenes y registro del panel de administración: solo los escribe el servidor.
    match /adminStats/{dayId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /adminAuditLog/{entryId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /securityEvents/{eventId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /userGamification/{userId} {
      allow read: if isSelf(userId) || isAdmin();
      allow write: if false;
    }

    match /loginAttempts/{attemptId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
