rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return isSignedIn() && userDoc().data.role == 'admin';
    }

    function isCompanyOwner(companyId) {
      return isSignedIn() && (
        get(/databases/$(database)/documents/companies/$(companyId)).data.ownerUid == request.auth.uid
        || (
          userDoc().data.role == 'company'
          && userDoc().data.companyId == companyId
        )
      );
    }

    match /logins/{loginId} {
      allow get: if true;
      allow list: if false;
      allow write: if isAdmin();
    }

    match /companyCredentials/{companyId} {
      allow read: if isAdmin() || isCompanyOwner(companyId);
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isCompanyOwner(companyId)
        && (
          (
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['loginPassword', 'mustChangePassword', 'updatedAt'])
            && request.resource.data.loginPassword is string
          )
          || (
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['loginName', 'updatedAt'])
            && request.resource.data.loginName is string
            && request.resource.data.loginName.size() > 0
          )
        )
      );
    }

    match /passwordResetTokens/{tokenId} {
      allow read, write: if false;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidCustomerCreate() {
      let data = request.resource.data;
      return data.role == 'customer'
        && data.companyId == null
        && data.email is string
        && data.email.size() > 0
        && data.displayName is string
        && data.displayName.size() > 0
        && (data.authProvider == 'password' || data.authProvider == 'google.com')
        && data.mustChangePassword == false
        && data.onboardingCompleted == false
        && data.phone is string
        && data.phoneVerified is bool
        && data.photoUrl is string
        && data.favoriteSlugs is list
        && data.foodPreferences is list
        && data.gamification is map
        && data.xp is int
        && data.adelinas is int
        && (data.homeLatitude == null || data.homeLatitude is number)
        && (data.homeLongitude == null || data.homeLongitude is number)
        && data.createdAt == request.time;
    }

    function customerProfileUpdateKeys() {
      return [
        'displayName',
        'favoriteSlugs',
        'phone',
        'phoneVerified',
        'photoUrl',
        'homeCity',
        'homeMunicipality',
        'homeCountry',
        'homePostalCode',
        'homeLatitude',
        'homeLongitude',
        'foodPreferences',
        'onboardingCompleted',
      ];
    }

    function customerGamificationUpdateKeys() {
      return ['gamification', 'xp', 'adelinas'];
    }

    match /users/{userId} {
      allow create: if isAdmin() || (isSelf(userId) && isValidCustomerCreate());
      allow read: if isSelf(userId) || isAdmin();
      allow update: if isAdmin() || (
        isSelf(userId)
        && userDoc().data.role == 'company'
        && userDoc().data.mustChangePassword == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mustChangePassword'])
        && request.resource.data.mustChangePassword == false
      ) || (
        isSelf(userId)
        && userDoc().data.role == 'company'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['loginName'])
        && request.resource.data.loginName is string
        && request.resource.data.loginName.size() > 0
      ) || (
        isSelf(userId)
        && userDoc().data.role == 'customer'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(customerProfileUpdateKeys())
      ) || (
        isSelf(userId)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(customerGamificationUpdateKeys())
      );
      allow delete: if isAdmin();

      match /notifications/{notificationId} {
        allow read: if isSelf(userId) || isAdmin();
        allow update: if isSelf(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt'])
          && request.resource.data.read == true;
        allow create, delete: if false;
      }

      match /friendRequests/{requestId} {
        allow read: if isSelf(userId) || isAdmin();
        allow write: if false;
      }

      match /outgoingFriendRequests/{requestId} {
        allow read: if isSelf(userId) || isAdmin();
        allow write: if false;
      }

      match /friends/{friendId} {
        allow read: if isSelf(userId) || isAdmin();
        allow write: if false;
      }
    }

    match /notificationJobs/{jobId} {
      allow read, write: if false;
    }

    function isValidPublicReservation() {
      let data = request.resource.data;
      return data.companyId is string
        && data.tableId is string
        && data.clientName is string
        && data.clientName.size() > 0
        && data.clientEmail is string
        && data.clientEmail.size() > 0
        && data.clientPhone is string
        && data.clientPhone.size() > 0
        && data.pax is int
        && data.pax >= 1
        && data.pax <= 50
        && data.status == 'completed'
        && data.startTime is timestamp
        && data.endTime is timestamp
        && data.cancelToken is string
        && data.cancelToken.size() > 0
        && data.notes is string;
    }

    function isValidCompanyOwnerUpdate() {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return !changedKeys.hasAny(['slug', 'ownerUid', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0;
    }

    function isValidCustomerReviewStatsUpdate(companyId) {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc().data.role == 'customer'
        && changedKeys.hasOnly(['reviewCount', 'reviewRatingSum', 'reviewAdelinas'])
        && request.resource.data.reviewCount is number
        && request.resource.data.reviewRatingSum is number
        && request.resource.data.reviewAdelinas is number
        && request.resource.data.reviewCount >= 0
        && request.resource.data.reviewRatingSum >= 0
        && request.resource.data.reviewAdelinas >= 0;
    }

    function isValidReviewCreate(companyId, reviewId) {
      let data = request.resource.data;
      return reviewId == request.auth.uid
        && data.companyId == companyId
        && data.reservationId is string
        && data.customerUid == request.auth.uid
        && data.customerName is string
        && data.rating is number
        && data.rating is int
        && data.rating >= 1
        && data.rating <= 5
        && data.comment is string
        && data.comment.size() >= 10
        && data.hasPhoto is bool
        && data.adelinasEarned is number
        && data.adelinasEarned >= 1
        && data.createdAt == request.time
        && (!('updatedAt' in data) || data.updatedAt == request.time)
        && (!('mediaItems' in data) || data.mediaItems is list)
        && (!('taggedProducts' in data) || data.taggedProducts is list)
        && (!('taggedPromotions' in data) || data.taggedPromotions is list);
    }

    function isValidReviewUpdate(companyId) {
      let data = request.resource.data;
      return data.companyId == companyId
        && resource.data.customerUid == request.auth.uid
        && data.customerUid == request.auth.uid
        && data.customerName is string
        && data.rating is number
        && data.rating is int
        && data.rating >= 1
        && data.rating <= 5
        && data.comment is string
        && data.comment.size() >= 10
        && data.hasPhoto is bool
        && data.adelinasEarned is number
        && data.adelinasEarned >= 1
        && (!('updatedAt' in data) || data.updatedAt == request.time)
        && (!('mediaItems' in data) || data.mediaItems is list)
        && (!('taggedProducts' in data) || data.taggedProducts is list)
        && (!('taggedPromotions' in data) || data.taggedPromotions is list);
    }

    function reviewHasOwnerReply(data) {
      return data.keys().hasAny(['ownerReply'])
        && data.ownerReply is map
        && data.ownerReply.text is string
        && data.ownerReply.text.size() > 0;
    }

    function isValidCompanyReviewReplyUpdate(companyId) {
      let data = request.resource.data;
      let prev = resource.data;
      let changedKeys = data.diff(prev).affectedKeys();
      let reply = data.ownerReply;
      let hadReply = reviewHasOwnerReply(prev);

      return isCompanyOwner(companyId)
        && data.companyId == prev.companyId
        && changedKeys.hasOnly(['ownerReply'])
        && reply is map
        && reply.text is string
        && reply.text.size() >= 3
        && reply.text.size() <= 1000
        && reply.createdAt is timestamp
        && reply.updatedAt is timestamp
        && (
          (!hadReply && reply.createdAt == request.time && reply.updatedAt == request.time)
          || (
            hadReply
            && reply.createdAt == prev.ownerReply.createdAt
            && reply.updatedAt == request.time
          )
        );
    }

    match /companies/{companyId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isCompanyOwner(companyId)
        && isValidCompanyOwnerUpdate()
      ) || isValidCustomerReviewStatsUpdate(companyId);

      match /clients/{clientId} {
        allow read: if isCompanyOwner(companyId) || isAdmin();
        allow create, update: if isCompanyOwner(companyId) || isAdmin();
        allow delete: if isAdmin();
      }

      match /promotions/{promotionId} {
        allow get: if resource.data.active == true || isCompanyOwner(companyId) || isAdmin();
        allow list: if isCompanyOwner(companyId) || isAdmin() || resource.data.active == true;
        allow create, update, delete: if isCompanyOwner(companyId) || isAdmin();
      }

      match /menuBoards/{boardId} {
        allow get: if resource.data.active == true || isCompanyOwner(companyId) || isAdmin();
        allow list: if isCompanyOwner(companyId) || isAdmin() || resource.data.active == true;
        allow create, update, delete: if isCompanyOwner(companyId) || isAdmin();
      }

      match /menuNodes/{nodeId} {
        allow get: if resource.data.active == true || isCompanyOwner(companyId) || isAdmin();
        allow list: if isCompanyOwner(companyId) || isAdmin() || resource.data.active == true;
        allow create, update, delete: if isCompanyOwner(companyId) || isAdmin();
      }

      match /verifiedConsumptions/{consumptionId} {
        allow read: if isCompanyOwner(companyId) || isAdmin();
        allow write: if false;
      }

      match /reviews/{reviewId} {
        allow get, list: if true;
        allow create: if isSignedIn()
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && userDoc().data.role == 'customer'
          && isValidReviewCreate(companyId, reviewId);
        allow update: if isAdmin() || (
          isCompanyOwner(companyId)
          && isValidCompanyReviewReplyUpdate(companyId)
        ) || (
          isSignedIn()
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && userDoc().data.role == 'customer'
          && resource.data.customerUid == request.auth.uid
          && isValidReviewUpdate(companyId)
        );
        allow delete: if isCompanyOwner(companyId) || isAdmin() || (
          isSignedIn()
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && userDoc().data.role == 'customer'
          && resource.data.customerUid == request.auth.uid
        );
      }
    }

    match /tables/{tableId} {
      allow read: if true;
      allow create: if isSignedIn()
        && (isAdmin() || isCompanyOwner(request.resource.data.companyId));
      allow update, delete: if isSignedIn()
        && (isAdmin() || isCompanyOwner(resource.data.companyId));
    }

    function canReadReservation() {
      return isAdmin()
        || isCompanyOwner(resource.data.companyId)
        || (
          isSignedIn()
          && userDoc().data.role == 'customer'
          && resource.data.clientEmail == userDoc().data.email
        );
    }

    match /reservations/{reservationId} {
      allow get, list: if canReadReservation();
      allow create: if isSignedIn()
        && (isAdmin() || isCompanyOwner(request.resource.data.companyId));
      allow update, delete: if isSignedIn()
        && (isAdmin() || isCompanyOwner(resource.data.companyId));
    }
  }
}
