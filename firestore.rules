rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return isSignedIn() && userDoc().data.role == 'admin';
    }

    function isCompanyOwner(companyId) {
      return isSignedIn() && (
        get(/databases/$(database)/documents/companies/$(companyId)).data.ownerUid == request.auth.uid
        || (
          userDoc().data.role == 'company'
          && userDoc().data.companyId == companyId
        )
      );
    }

    match /logins/{loginId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /companyCredentials/{companyId} {
      allow read: if isAdmin() || isCompanyOwner(companyId);
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isCompanyOwner(companyId)
        && (
          (
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['loginPassword', 'mustChangePassword', 'updatedAt'])
            && request.resource.data.loginPassword is string
          )
          || (
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['loginName', 'updatedAt'])
            && request.resource.data.loginName is string
            && request.resource.data.loginName.size() > 0
          )
        )
      );
    }

    match /passwordResetTokens/{tokenId} {
      allow read, write: if false;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidCustomerCreate() {
      let data = request.resource.data;
      return data.role == 'customer'
        && data.companyId == null
        && data.email is string
        && data.email.size() > 0
        && data.displayName is string
        && data.displayName.size() > 0
        && (data.authProvider == 'password' || data.authProvider == 'google.com')
        && data.mustChangePassword == false
        && data.onboardingCompleted == false
        && data.phone is string
        && data.phoneVerified is bool
        && data.photoUrl is string
        && data.favoriteSlugs is list
        && data.foodPreferences is list
        && data.gamification is map
        && data.xp is int
        && data.adelinas is int
        && (data.homeLatitude == null || data.homeLatitude is number)
        && (data.homeLongitude == null || data.homeLongitude is number)
        && data.createdAt == request.time;
    }

    function customerProfileUpdateKeys() {
      return [
        'displayName',
        'favoriteSlugs',
        'phone',
        'phoneVerified',
        'photoUrl',
        'homeCity',
        'homeMunicipality',
        'homeCountry',
        'homePostalCode',
        'homeLatitude',
        'homeLongitude',
        'foodPreferences',
        'onboardingCompleted',
      ];
    }

    function customerGamificationUpdateKeys() {
      return ['gamification', 'xp', 'adelinas'];
    }

    match /users/{userId} {
      allow create: if isAdmin() || (isSelf(userId) && isValidCustomerCreate());
      allow read: if isSelf(userId) || isAdmin();
      allow update: if isAdmin() || (
        isSelf(userId)
        && userDoc().data.role == 'company'
        && userDoc().data.mustChangePassword == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mustChangePassword'])
        && request.resource.data.mustChangePassword == false
      ) || (
        isSelf(userId)
        && userDoc().data.role == 'company'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['loginName'])
        && request.resource.data.loginName is string
        && request.resource.data.loginName.size() > 0
      ) || (
        isSelf(userId)
        && userDoc().data.role == 'customer'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(customerProfileUpdateKeys())
      ) || (
        isSelf(userId)
        && userDoc().data.role == 'customer'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(customerGamificationUpdateKeys())
      );
      allow delete: if isAdmin();
    }

    function isValidPublicReservation() {
      let data = request.resource.data;
      return data.companyId is string
        && data.tableId is string
        && data.clientName is string
        && data.clientName.size() > 0
        && data.clientEmail is string
        && data.clientEmail.size() > 0
        && data.clientPhone is string
        && data.clientPhone.size() > 0
        && data.pax is int
        && data.pax >= 1
        && data.pax <= 50
        && data.status == 'completed'
        && data.startTime is timestamp
        && data.endTime is timestamp
        && data.cancelToken is string
        && data.cancelToken.size() > 0
        && data.notes is string;
    }

    function isValidCompanyOwnerUpdate() {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return !changedKeys.hasAny(['slug', 'ownerUid', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0;
    }

    match /companies/{companyId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isCompanyOwner(companyId)
        && isValidCompanyOwnerUpdate()
      );

      match /clients/{clientId} {
        allow read: if isCompanyOwner(companyId) || isAdmin();
        allow create, update: if isCompanyOwner(companyId) || isAdmin();
        allow delete: if isAdmin();
      }

      match /promotions/{promotionId} {
        allow get: if resource.data.active == true || isCompanyOwner(companyId) || isAdmin();
        allow list: if isCompanyOwner(companyId) || isAdmin() || resource.data.active == true;
        allow create, update, delete: if isCompanyOwner(companyId) || isAdmin();
      }

      match /menuBoards/{boardId} {
        allow get: if resource.data.active == true || isCompanyOwner(companyId) || isAdmin();
        allow list: if isCompanyOwner(companyId) || isAdmin() || resource.data.active == true;
        allow create, update, delete: if isCompanyOwner(companyId) || isAdmin();
      }

      match /menuNodes/{nodeId} {
        allow get: if resource.data.active == true || isCompanyOwner(companyId) || isAdmin();
        allow list: if isCompanyOwner(companyId) || isAdmin() || resource.data.active == true;
        allow create, update, delete: if isCompanyOwner(companyId) || isAdmin();
      }
    }

    match /tables/{tableId} {
      allow read: if true;
      allow create: if isSignedIn()
        && (isAdmin() || isCompanyOwner(request.resource.data.companyId));
      allow update, delete: if isSignedIn()
        && (isAdmin() || isCompanyOwner(resource.data.companyId));
    }

    match /reservations/{reservationId} {
      allow read: if true;
      allow create: if isValidPublicReservation() || (
        isSignedIn()
        && (isAdmin() || isCompanyOwner(request.resource.data.companyId))
      );
      allow update, delete: if isSignedIn()
        && (isAdmin() || isCompanyOwner(resource.data.companyId));
    }
  }
}
