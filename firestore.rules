rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userDocExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return isSignedIn() && userDocExists() && userDoc().data.role == 'admin';
    }

    function hasNoPasswordSecrets(data) {
      return !('loginPassword' in data)
        && !('password' in data)
        && !('passwordHash' in data)
        && !('passwordSalt' in data);
    }

    function isCompanyOwner(companyId) {
      return isSignedIn() && (
        (
          exists(/databases/$(database)/documents/companies/$(companyId))
          && get(/databases/$(database)/documents/companies/$(companyId)).data.ownerUid == request.auth.uid
        )
        || (
          userDocExists()
          && userDoc().data.role == 'company'
          && userDoc().data.companyId == companyId
        )
      );
    }

    match /logins/{loginId} {
      // Empresas pueden leer su propio login, admins todo
      allow get: if isAdmin() || (
        isSignedIn()
        && resource.data.companyId is string
        && isCompanyOwner(resource.data.companyId)
      );
      allow list: if false;
      allow create, update: if (isAdmin() || (
        isSignedIn()
        && request.resource.data.role == 'company'
        && request.resource.data.loginName is string
        && request.resource.data.loginName.size() > 0
        && request.resource.data.loginName.size() <= 80
        && request.resource.data.authEmail is string
        && request.resource.data.authEmail.size() <= 120
        && request.resource.data.companyId is string
        && isCompanyOwner(request.resource.data.companyId)
      )) && hasNoPasswordSecrets(request.resource.data);
      allow delete: if isAdmin();
    }

    match /companyCredentials/{companyId} {
      allow read: if isAdmin() || isCompanyOwner(companyId);
      allow create: if isAdmin() && hasNoPasswordSecrets(request.resource.data);
      allow delete: if isAdmin();
      allow update: if hasNoPasswordSecrets(request.resource.data) && (
        isAdmin() || (
          isCompanyOwner(companyId)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['loginName', 'updatedAt'])
          && request.resource.data.loginName is string
          && request.resource.data.loginName.size() > 0
          && request.resource.data.loginName.size() <= 80
        )
      );
    }

    match /passwordResetTokens/{tokenId} {
      allow read, write: if false;
    }

    match /rateLimits/{limitId} {
      // Solo Cloud Functions pueden leer/escribir
      allow read, write: if false;
    }

    match /stripeEvents/{eventId} {
      // Registro de idempotencia de webhooks de Stripe. Solo backend (Admin SDK).
      allow read, write: if false;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isSafePhotoUrl(url) {
      return url is string
        && url.size() <= 500
        && (
          url == ''
          || url.matches('^https://res\\.cloudinary\\.com/')
          || url.matches('^https://[a-z0-9.-]*googleusercontent\\.com/')
        );
    }

    function isFreshCustomerEconomy(data) {
      return data.xp == 0
        && data.adelinas == 0
        && data.gamification.xp == 0
        && data.gamification.adelinas == 0
        && data.gamification.completedMissions.size() == 0
        && data.gamification.inventory.size() == 0
        && data.gamification.claimedPromotions.size() == 0
        && data.gamification.pendingTokenSpend.size() == 0
        && data.gamification.grantedItemKeys.size() == 0
        && data.gamification.visitedCompanyIds.size() == 0
        && data.gamification.promoLocked == false
        && data.gamification.cancellationStrikeCount == 0;
    }

    function isValidCustomerCreate() {
      let data = request.resource.data;
      return data.role == 'customer'
        && data.companyId == null
        && data.email is string
        && data.email.size() > 0
        && data.email.size() <= 120
        && data.displayName is string
        && data.displayName.size() > 0
        && data.displayName.size() <= 80
        && (data.authProvider == 'password' || data.authProvider == 'google.com')
        && data.mustChangePassword == false
        && data.onboardingCompleted == false
        && data.phone is string
        && data.phone.size() <= 30
        && data.phoneVerified is bool
        && isSafePhotoUrl(data.photoUrl)
        && data.favoriteSlugs is list
        && data.favoriteSlugs.size() <= 200
        && data.foodPreferences is list
        && data.foodPreferences.size() <= 40
        && data.gamification is map
        && data.xp is int
        && data.adelinas is int
        && isFreshCustomerEconomy(data)
        && (!('blocked' in data) || data.blocked == false)
        && (data.homeLatitude == null || data.homeLatitude is number)
        && (data.homeLongitude == null || data.homeLongitude is number)
        && data.createdAt == request.time
        && hasNoPasswordSecrets(data);
    }

    function customerProfileUpdateKeys() {
      return [
        'displayName',
        'displayNameLower',
        'favoriteSlugs',
        'phone',
        'photoUrl',
        'homeCity',
        'homeMunicipality',
        'homeCountry',
        'homePostalCode',
        'homeLatitude',
        'homeLongitude',
        'foodPreferences',
        'onboardingCompleted',
      ];
    }

    match /users/{userId} {
      allow create: if isAdmin() || (isSelf(userId) && isValidCustomerCreate());
      allow read: if isSelf(userId) || isAdmin();
      allow update: if isAdmin() || (
        isSelf(userId)
        && userDoc().data.role == 'company'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['loginName'])
        && request.resource.data.loginName is string
        && request.resource.data.loginName.size() > 0
      ) || (
        isSelf(userId)
        && userDoc().data.role == 'customer'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['favoriteSlugs'])
        && request.resource.data.favoriteSlugs is list
        && request.resource.data.favoriteSlugs.size() <= 200
      ) || (
        isSelf(userId)
        && userDoc().data.role == 'customer'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(customerProfileUpdateKeys())
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 30
        && isSafePhotoUrl(request.resource.data.photoUrl)
        && request.resource.data.favoriteSlugs is list
        && request.resource.data.favoriteSlugs.size() <= 200
        && request.resource.data.foodPreferences is list
        && request.resource.data.foodPreferences.size() <= 40
        && (!('homeCity' in request.resource.data) || (request.resource.data.homeCity is string && request.resource.data.homeCity.size() <= 80))
        && (!('homeMunicipality' in request.resource.data) || (request.resource.data.homeMunicipality is string && request.resource.data.homeMunicipality.size() <= 80))
        && (!('homeCountry' in request.resource.data) || (request.resource.data.homeCountry is string && request.resource.data.homeCountry.size() <= 80))
        && (!('homePostalCode' in request.resource.data) || (request.resource.data.homePostalCode is string && request.resource.data.homePostalCode.size() <= 16))
      );
      allow delete: if isAdmin();

      match /notifications/{notificationId} {
        allow read: if isSelf(userId) || isAdmin();
        allow update: if isSelf(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt'])
          && request.resource.data.read == true;
        allow create, delete: if false;
      }

      match /friendRequests/{requestId} {
        allow read: if isSelf(userId) || isAdmin();
        allow write: if false;
      }

      match /outgoingFriendRequests/{requestId} {
        allow read: if isSelf(userId) || isAdmin();
        allow write: if false;
      }

      match /friends/{friendId} {
        allow read: if isSelf(userId) || isAdmin();
        allow write: if false;
      }
    }

    match /notificationJobs/{jobId} {
      allow read, write: if false;
    }

    function isValidCompanyOwnerUpdate() {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      // El plan, el cobro y el destaco los asigna solo el admin.
      return !changedKeys.hasAny([
          'slug',
          'ownerUid',
          'createdAt',
          'planId',
          'planBilling',
          'planStartedAt',
          'planLastPaidAt',
          'discoveryFeatured',
          'stripeAccountId',
          'stripeChargesEnabled',
          'stripePayoutsEnabled',
          'stripeDetailsSubmitted',
          'emailTemplates',
          'reviewCount',
          'reviewRatingSum',
          'reviewAdelinas',
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0;
    }

    function reviewHasOwnerReply(data) {
      return data.keys().hasAny(['ownerReply'])
        && data.ownerReply is map
        && data.ownerReply.text is string
        && data.ownerReply.text.size() > 0;
    }

    function isValidCompanyReviewReplyUpdate(companyId) {
      let data = request.resource.data;
      let prev = resource.data;
      let changedKeys = data.diff(prev).affectedKeys();
      let reply = data.ownerReply;
      let hadReply = reviewHasOwnerReply(prev);

      return isCompanyOwner(companyId)
        && data.companyId == prev.companyId
        && changedKeys.hasOnly(['ownerReply'])
        && reply is map
        && reply.text is string
        && reply.text.size() >= 3
        && reply.text.size() <= 1000
        && reply.createdAt is timestamp
        && reply.updatedAt is timestamp
        && (
          (!hadReply && reply.createdAt == request.time && reply.updatedAt == request.time)
          || (
            hadReply
            && reply.createdAt == prev.ownerReply.createdAt
            && reply.updatedAt == request.time
          )
        );
    }

    match /companies/{companyId} {
      allow read: if isAdmin() || isCompanyOwner(companyId);
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isCompanyOwner(companyId)
        && isValidCompanyOwnerUpdate()
      );

      match /private/{privateDoc} {
        allow read, create, update, delete: if isCompanyOwner(companyId) || isAdmin();
      }

      match /clients/{clientId} {
        allow read: if isCompanyOwner(companyId) || isAdmin();
        allow create, update: if isCompanyOwner(companyId) || isAdmin();
        allow delete: if isAdmin();
      }

      match /promotions/{promotionId} {
        allow get: if resource.data.active == true || isCompanyOwner(companyId) || isAdmin();
        // list sin resource.data: el dueño puede leer inactivas. Firestore no filtra.
        allow list: if isCompanyOwner(companyId) || isAdmin();
        allow list: if resource.data.active == true;
        allow create, update, delete: if isCompanyOwner(companyId) || isAdmin();
      }

      match /menuBoards/{boardId} {
        allow get: if resource.data.active == true || isCompanyOwner(companyId) || isAdmin();
        allow list: if isCompanyOwner(companyId) || isAdmin();
        allow list: if resource.data.active == true;
        allow create, update, delete: if isCompanyOwner(companyId) || isAdmin();
      }

      match /menuNodes/{nodeId} {
        allow get: if resource.data.active == true || isCompanyOwner(companyId) || isAdmin();
        allow list: if isCompanyOwner(companyId) || isAdmin();
        allow list: if resource.data.active == true;
        allow create, update, delete: if isCompanyOwner(companyId) || isAdmin();
      }

      match /verifiedConsumptions/{consumptionId} {
        allow read: if isCompanyOwner(companyId) || isAdmin();
        allow write: if false;
      }

      match /reviews/{reviewId} {
        // El doc lleva customerUid y reservationId: no debe ser mundo-legible.
        // El público lee las reseñas por la API (/api/public/booking/:slug/reviews),
        // que las sanea con mapPublicReview.
        allow get, list: if isCompanyOwner(companyId) || isAdmin();
        allow create: if false;
        allow update: if isAdmin() || (
          isCompanyOwner(companyId)
          && isValidCompanyReviewReplyUpdate(companyId)
        );
        // Solo admin puede borrar reviews para mantener credibilidad del sistema
        // Las empresas pueden responder pero no eliminar reseñas negativas
        allow delete: if isAdmin();
      }

      match /notifications/{notificationId} {
        allow read: if isCompanyOwner(companyId) || isAdmin();
        allow update: if isCompanyOwner(companyId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt'])
          && request.resource.data.read == true;
        allow create, delete: if false;
      }
    }

    match /{path=**}/verifiedConsumptions/{consumptionId} {
      allow read: if isSignedIn()
        && resource.data.customerUid == request.auth.uid;
      allow write: if false;
    }

    match /tables/{tableId} {
      allow read: if isAdmin() || (
        isSignedIn() && isCompanyOwner(resource.data.companyId)
      );
      allow create: if isSignedIn()
        && (isAdmin() || isCompanyOwner(request.resource.data.companyId));
      allow update, delete: if isSignedIn()
        && (isAdmin() || isCompanyOwner(resource.data.companyId));
    }

    function canReadReservation() {
      return isAdmin()
        || isCompanyOwner(resource.data.companyId)
        || (
          isSignedIn()
          && 'customerUid' in resource.data
          && resource.data.customerUid == request.auth.uid
        )
        || (
          isSignedIn()
          && request.auth.token.email_verified == true
          && resource.data.clientEmail is string
          && resource.data.clientEmail == request.auth.token.email
          && (
            !('customerUid' in resource.data)
            || resource.data.customerUid == null
            || resource.data.customerUid == ''
          )
        );
    }

    match /reservations/{reservationId} {
      allow get, list: if canReadReservation();
      allow create: if false;
      allow update, delete: if isSignedIn()
        && (isAdmin() || isCompanyOwner(resource.data.companyId));
    }

    match /restaurantIndex/{companyId} {
      allow read: if true;
      allow delete: if isAdmin();
      allow create: if isAdmin() || (
        isCompanyOwner(companyId)
        && request.resource.data.companyId == companyId
        && request.resource.data.discoveryFeatured != true
        && (!('reviewCount' in request.resource.data) || request.resource.data.reviewCount == 0)
        && (!('reviewRatingSum' in request.resource.data) || request.resource.data.reviewRatingSum == 0)
        && (!('reviewAdelinas' in request.resource.data) || request.resource.data.reviewAdelinas == 0)
      );
      allow update: if isAdmin() || (
        isCompanyOwner(companyId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'discoveryFeatured',
          'reviewCount',
          'reviewRatingSum',
          'reviewAdelinas',
          'companyId',
          'slug',
        ])
      );
    }

    match /friendships/{friendshipId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.userIds;
      allow write: if false;
    }

    match /friendRequests/{requestId} {
      allow read: if isSignedIn()
        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow write: if false;
    }

    match /friendFavorites/{favoriteId} {
      allow read: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
      allow write: if false;
    }

    match /reservationInvites/{inviteId} {
      allow read: if isSignedIn()
        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow write: if false;
    }

    match /reservationChallenges/{challengeId} {
      allow read: if isSignedIn()
        && (
          resource.data.challengerUid == request.auth.uid
          || resource.data.challengedUid == request.auth.uid
        );
      allow write: if false;

      match /secret/{docId} {
        allow read, write: if false;
      }
    }

    match /companyGamification/{companyId} {
      allow read: if isCompanyOwner(companyId) || isAdmin();
      allow write: if false;
    }

    match /promotionClaims/{claimId} {
      allow read: if isSignedIn() && (
        resource.data.customerUid == request.auth.uid
        || isCompanyOwner(resource.data.companyId)
        || isAdmin()
      );
      allow write: if false;
    }

    match /userFavorites/{favoriteId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create, update: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.slug is string
        && request.resource.data.slug.size() > 0
        && request.resource.data.slug.size() <= 80
        && request.resource.data.slug.matches('^[a-z0-9]+(-[a-z0-9]+)*$');
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /reviewIndex/{reviewId} {
      // Lleva customerUid + reservationId + extracto del comentario. Solo admin.
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /saasSubscriptions/{sessionId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /planChangeRequests/{requestId} {
      allow create: if isSignedIn()
        && request.resource.data.companyId is string
        && request.resource.data.companyId.size() <= 128
        && isCompanyOwner(request.resource.data.companyId)
        && request.resource.data.status == 'pending'
        && request.resource.data.fromPlanId is string
        && request.resource.data.fromPlanId.size() <= 40
        && request.resource.data.toPlanId is string
        && request.resource.data.toPlanId.size() <= 40
        && request.resource.data.companyName is string
        && request.resource.data.companyName.size() > 0
        && request.resource.data.companyName.size() <= 80;
      allow read: if isAdmin()
        || (
          isSignedIn()
          && resource.data.companyId is string
          && isCompanyOwner(resource.data.companyId)
        );
      allow update, delete: if isAdmin();
    }

    match /productClaims/{claimId} {
      allow read: if isSignedIn() && (
        resource.data.customerUid == request.auth.uid
        || isCompanyOwner(resource.data.companyId)
        || isAdmin()
      );
      allow write: if false;
    }

    match /missionCatalog/{missionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /levelCatalog/{levelId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /gameConfig/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /securityEvents/{eventId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /userGamification/{userId} {
      allow read: if isSelf(userId) || isAdmin();
      allow write: if false;
    }

    match /loginAttempts/{attemptId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
